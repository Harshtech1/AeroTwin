# ==========================================
# AeroTwin Environment Configuration Templates
# ==========================================

# --- General ---
PROJECT_NAME=AeroTwin
ENVIRONMENT=development
DEBUG=true

# --- Server Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Database (PostgreSQL) ---
POSTGRES_DB=aerotwin_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- AI APIs (Optional for future narration and vision) ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Maps APIs (Optional for future Cesium and Mapbox visualization) ---
CESIUM_ION_TOKEN=your_cesium_ion_token_here
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
